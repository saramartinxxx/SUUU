{
  "tailwindCSS.experimental.classRegex": [
    "className\\s*=\\s*\"([^\"]*)\"",
    "className\\s*=\\s*'([^']*)'",
    "className\\s*=\\s*`([^`]*)`",
    "classList\\.add\\(\\s*\"([^\"]*)\"\\s*\\)",
    "classList\\.add\\(\\s*'([^']*)'\\s*\\)",
    "classList\\.add\\(\\s*`([^']*)`\\s*\\)",
    [
      "\\/\\*\\s*html\\s*\\*\\/\\s*`([^`]+)`",
      "class=\"([^\"]*)\""
    ]
  ],
  "tailwindCSS.includeLanguages": {
    "javascript": "html"
  },
  "emmet.includeLanguages": {
    "javascript": "html"
  }
}